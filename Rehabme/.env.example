# ReHabMe — development configuration template. Copy to `.env` (never commit `.env`).
APP_ENV=development
PORT=3001
DATABASE_PATH=server/data/rehabme.sqlite
CORS_ORIGINS=http://localhost:5173

# Auth: "local" (dev/test/staging/demo only) or "firebase" (required in production)
AUTH_PROVIDER=local
FIREBASE_PROJECT_ID=rehabme-4ba77
# LOCAL_AUTH_SECRET=   # optional in development (a dev-only default is used)

# Field-level encryption key: 32 random bytes, base64. Optional in development (deterministic dev key).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# DATA_ENCRYPTION_KEY=
AUDIT_IP_SALT=change-me

# LLM (optional). Patient text is sent to an external provider ONLY if LLM_EXTERNAL_PROCESSING_APPROVED=true
# (requires a signed data-processing agreement) AND the patient gave the separate consent.
# OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_EXTERNAL_PROCESSING_APPROVED=false
KB_REQUIRE_APPROVED=false
AI_MESSAGE_RETENTION_DAYS=90

# ML inference service
ML_SERVICE_URL=http://127.0.0.1:8001
ML_TIMEOUT_MS=3000
ML_ALLOW_DEMO_MODELS=true

LOG_LEVEL=info
SERVE_STATIC=false

# Frontend (Vite)
VITE_AUTH_PROVIDER=local
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
