# ReHabMe — STAGING / public DEMO template. No real patient data in this environment, ever.
APP_ENV=staging
PORT=3001
DATABASE_PATH=/data/rehabme-staging.sqlite
CORS_ORIGINS=https://staging.example.org
TRUST_PROXY=true
SERVE_STATIC=true
AUTH_PROVIDER=local
LOCAL_AUTH_SECRET=<random-64-chars>
DATA_ENCRYPTION_KEY=<32-bytes-base64>
AUDIT_IP_SALT=<random>
LLM_EXTERNAL_PROCESSING_APPROVED=false
KB_REQUIRE_APPROVED=false
ML_SERVICE_URL=http://ml:8001
ML_ALLOW_DEMO_MODELS=true
VITE_AUTH_PROVIDER=local
