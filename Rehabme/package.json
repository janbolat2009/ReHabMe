{
  "name": "rehabme",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "ReHabMe — digital rehabilitation platform for stroke survivors (research/demo stage, not a certified medical device)",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "node --watch server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "db:migrate": "node server/db/migrate.js",
    "db:seed:dev": "node server/db/seed-dev.js",
    "admin:set-role": "node server/scripts/set-role.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "check:release-gates": "node scripts/check-release-gates.js",
    "audit:deps": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.2.5",
    "@fontsource-variable/onest": "^5.2.5",
    "@fontsource-variable/unbounded": "^5.2.5",
    "@fontsource/cormorant-garamond": "^5.2.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase": "^12.7.0",
    "helmet": "^8.0.0",
    "jose": "^5.9.6",
    "openai": "^7.63.0",
    "pinia": "^3.0.4",
    "pino": "^9.6.0",
    "vue": "^3.5.24",
    "vue-router": "^4.6.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.49.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "supertest": "^7.0.0",
    "vite": "^7.1.11",
    "vitest": "^3.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  }
}
